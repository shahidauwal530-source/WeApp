{
  "entities": {
    "PrivateUser": {
      "title": "PrivateUser",
      "description": "Private user account profile containing PII, global locale/currency, privacy, security, notification, and appearance preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "countryCode": { "type": "string" },
        "countryName": { "type": "string" },
        "countryFlag": { "type": "string" },
        "city": { "type": "string" },
        "currencyCode": { "type": "string" },
        "bio": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "gender": { "type": "string" },
        "website": { "type": "string" },
        "work": { "type": "string" },
        "education": { "type": "string" },
        "relationshipStatus": { "type": "string" },
        "photoUrl": { "type": "string" },
        "coverPhotoUrl": { "type": "string" },
        "plan": { "type": "string", "enum": ["FREE", "PRO", "VIP"] },
        "coins": { "type": "integer" },
        "rankPoints": { "type": "integer" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "postsCount": { "type": "integer" },
        "darkMode": { "type": "boolean" },
        "themeMode": { "type": "string", "enum": ["dark", "light", "system"] },
        "fontSize": { "type": "string", "enum": ["small", "medium", "large"] },
        "language": { "type": "string", "enum": ["en", "ha", "pcm", "fr", "ar", "es", "pt", "hi", "sw"] },
        "dataSaver": { "type": "boolean" },
        "autoPlayVideos": { "type": "boolean" },
        "showFewerAds": { "type": "boolean" },
        "twoFactorEnabled": { "type": "boolean" },
        "loginAlertsEnabled": { "type": "boolean" },
        "accountStatus": { "type": "string", "enum": ["active", "deactivated"] },
        "privacyPosts": { "type": "string" },
        "privacyFollow": { "type": "string" },
        "privacyMessage": { "type": "string" },
        "privacyFriends": { "type": "string" },
        "privacyTag": { "type": "string" },
        "privacyContact": { "type": "string" },
        "privacyBirthday": { "type": "string" },
        "searchableByEmail": { "type": "boolean" },
        "searchableByPhone": { "type": "boolean" },
        "searchableByUsername": { "type": "boolean" },
        "notifLikes": { "type": "boolean" },
        "notifComments": { "type": "boolean" },
        "notifFollows": { "type": "boolean" },
        "notifMessages": { "type": "boolean" },
        "notifChallenges": { "type": "boolean" },
        "notifLive": { "type": "boolean" },
        "notifFriendRequests": { "type": "boolean" },
        "notifPush": { "type": "boolean" },
        "notifSound": { "type": "boolean" },
        "notifVibration": { "type": "boolean" },
        "notifEmail": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "displayName", "email", "phone", "countryCode", "countryName", "countryFlag", "city", "currencyCode", "plan", "coins", "rankPoints", "followersCount", "followingCount", "postsCount", "darkMode", "language", "createdAt", "updatedAt"]
    },
    "PublicUser": {
      "title": "PublicUser",
      "description": "Public creator profile without PII for global search, discovery, and leaderboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "countryCode": { "type": "string" },
        "countryName": { "type": "string" },
        "countryFlag": { "type": "string" },
        "city": { "type": "string" },
        "bio": { "type": "string" },
        "website": { "type": "string" },
        "work": { "type": "string" },
        "education": { "type": "string" },
        "relationshipStatus": { "type": "string" },
        "photoUrl": { "type": "string" },
        "coverPhotoUrl": { "type": "string" },
        "plan": { "type": "string", "enum": ["FREE", "PRO", "VIP"] },
        "coins": { "type": "integer" },
        "rankPoints": { "type": "integer" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "postsCount": { "type": "integer" },
        "privacyMessage": { "type": "string" },
        "privacyFollow": { "type": "string" },
        "searchableByUsername": { "type": "boolean" },
        "accountStatus": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "displayName", "countryCode", "countryName", "countryFlag", "city", "plan", "coins", "rankPoints", "followersCount", "followingCount", "postsCount", "visibility", "createdAt", "updatedAt"]
    },
    "SafetyListEntry": {
      "title": "SafetyListEntry",
      "description": "Blocked, muted, or restricted user entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "targetUserId": { "type": "string" },
        "targetName": { "type": "string" },
        "listType": { "type": "string", "enum": ["blocked", "muted", "restricted"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "targetUserId", "targetName", "listType", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "User notification item.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "notifType": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "readFlag": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "actorId", "actorName", "notifType", "title", "body", "readFlag", "createdAt"]
    },
    "LoginSession": {
      "title": "LoginSession",
      "description": "Active device login session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "deviceName": { "type": "string" },
        "city": { "type": "string" },
        "countryName": { "type": "string" },
        "activeFlag": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "deviceName", "city", "countryName", "activeFlag", "createdAt", "updatedAt"]
    },
    "ContentReport": {
      "title": "ContentReport",
      "description": "Moderation report for posts, users, or comments.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["post", "user", "comment"] },
        "targetId": { "type": "string" },
        "reason": { "type": "string", "enum": ["Spam", "Harassment", "Fake", "Violence"] },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "targetType", "targetId", "reason", "details", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Global social feed post.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorCity": { "type": "string" },
        "authorCountryCode": { "type": "string" },
        "authorCountryFlag": { "type": "string" },
        "authorPlan": { "type": "string", "enum": ["FREE", "PRO", "VIP"] },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "postPrivacy": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public"] },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "sharesCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "authorCity", "authorPlan", "content", "category", "visibility", "likesCount", "commentsCount", "sharesCount", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/PrivateUser" }, "description": "Private user account & settings" },
    "/users/{userId}/liked_posts/{postId}": { "schema": "UserLike", "description": "Liked posts" },
    "/users/{userId}/liked_videos/{videoId}": { "schema": "UserLike", "description": "Liked videos" },
    "/users/{userId}/hidden_posts/{postId}": { "schema": "UserLike", "description": "Hidden posts" },
    "/users/{userId}/following/{targetUserId}": { "schema": "UserFollow", "description": "Followed creators" },
    "/users/{userId}/safety_lists/{targetUserId}": { "schema": { "$ref": "#/entities/SafetyListEntry" }, "description": "Blocked, muted, and restricted users" },
    "/users/{userId}/notifications/{notifId}": { "schema": { "$ref": "#/entities/UserNotification" }, "description": "User notifications" },
    "/users/{userId}/sessions/{sessionId}": { "schema": { "$ref": "#/entities/LoginSession" }, "description": "Active device sessions" },
    "/users/{userId}/wallet_transactions/{txId}": { "schema": "WalletTransaction", "description": "Wallet transactions" },
    "/users_public/{userId}": { "schema": { "$ref": "#/entities/PublicUser" }, "description": "Public global profiles" },
    "/stories/{storyId}": { "schema": "Story", "description": "Stories" },
    "/posts/{postId}": { "schema": { "$ref": "#/entities/Post" }, "description": "Global posts" },
    "/posts/{postId}/comments/{commentId}": { "schema": "Comment", "description": "Post comments" },
    "/videos/{videoId}": { "schema": "VideoReel", "description": "Video reels" },
    "/videos/{videoId}/comments/{commentId}": { "schema": "Comment", "description": "Video comments" },
    "/game_challenges/{challengeId}": { "schema": "GameChallenge", "description": "Gaming arena" },
    "/chats/{chatId}": { "schema": "ChatThread", "description": "Direct chats" },
    "/chats/{chatId}/messages/{messageId}": { "schema": "ChatMessage", "description": "Chat messages" },
    "/marketplace/{itemId}": { "schema": "MarketplaceListing", "description": "Global marketplace" },
    "/live_rooms/{roomId}": { "schema": "LiveRoom", "description": "Live rooms" },
    "/live_rooms/{roomId}/messages/{messageId}": { "schema": "LiveMessage", "description": "Live chat" },
    "/reports/{reportId}": { "schema": { "$ref": "#/entities/ContentReport" }, "description": "User safety reports" }
  }
}
